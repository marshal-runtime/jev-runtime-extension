{
  "name": "@marshal/jev",
  "version": "1.0.0",
  "description": "Runtime extension connecting Marshal to TypeSafe's Jev \"System One\" model: a @marshal/jev:client service plus jev.* capabilities and an in-chat connection card.",
  "private": true,
  "type": "commonjs",
  "main": "dist/runtime.cjs",
  "types": "src/index.ts",
  "files": [
    "dist",
    "runtime-extension.json",
    "README.md"
  ],
  "scripts": {
